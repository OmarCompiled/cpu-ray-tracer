#define STB_IMAGE_WRITE_IMPLEMENTATION
#include "../include/stb_image_write.h"
#include "../include/vec.h"
#include "../include/color.h"
#include "../include/ray.h"

// defining globally for ease of abstraction/export later
float aspect_ratio  = 16.0f / 9.0f;
int width           = 4096;
int height          = (int)(width / aspect_ratio) < 1 ? 1 : (int)(width/aspect_ratio);

float focal_length    = 1.0f;
float viewport_height = 2.0f;
float viewport_width  = viewport_height * (float(width)/height); // since aspect_ratio is ideal not actual

vec3 camera_position {0.0f, 0.0f, 0.0f};

//NOTE: Right-handed coordinates in use
vec3 viewport_u {viewport_width, 0.0f, 0.0f};
vec3 viewport_v {0.0f, -viewport_height, 0.0f}; // using screen coordinates; y top --> bottom

vec3 pixel_delta_u    = viewport_u / width;
vec3 pixel_delta_v    = viewport_v / height;
vec3 viewport_origin  = camera_position - vec3(0.0f, 0.0f, focal_length) - viewport_u/2 - viewport_v/2;
vec3 first_pixel      = viewport_origin + 0.5 * (pixel_delta_u + pixel_delta_v);

float hit_sphere(const vec3& center, float radius, const ray& r) {
  // ;;quadratic formula;; place here :)
  // may or may not normalize direction vector
  vec3 cq = center - r.origin();
  float a = r.direction().length_squared();
  float c = (cq.length_squared()) - (radius * radius);
  float b = 2 * dot(r.direction(), cq);
  float discriminant = b*b - 4*a*c;
  if(discriminant < 0) {
    return -1;
  } else {
    return -b * std::sqrt(discriminant) / (2.0f*a);
  }
}

color
ray_color(const ray& r) {
  float t = hit_sphere(-vec3::k(), 0.3f, r);
  if(t > 0.0f) {
    vec3 N = vec3(r.at(t) + vec3::k()).normalized();
    return 0.5f * (N+1.0f);
  }

  float a = 0.5f * (r.direction().normalized().y() + 1.0f); // -1.0f - 1.0f --> 0.0f - 1.0f
  return (1.0f - a)*color(1.0f) + a*color(0.5f, 0.7f, 1.0f); 
}

void
calculate_pixel_color(std::vector<uint8_t>& buffer, int pixel, int scanline) {
  vec3 pixel_center   = first_pixel + (pixel * pixel_delta_u) + (scanline * pixel_delta_v);
  vec3 ray_direction  = pixel_center - camera_position;
  ray r {camera_position, ray_direction};
  color pixel_color = ray_color(r);
  write_pixel_png(buffer, pixel_color);
}

void
calculate_pixels(std::vector<uint8_t>& buffer, int scanline) {
  for(int i = 0; i < width; i++) {
    calculate_pixel_color(buffer, i, scanline);
  }
}

int
main() {
  std::vector<std::thread> threads;
  std::vector<uint8_t> buffer; // uint8_t necessary for stb_image_write functions.

  for(int j = 0; j < height; j++) {
    //threads.emplace_back(calculate_pixel, std::ref(buffer), j).join();
    calculate_pixels(buffer, j);
  }

  stbi_write_png("image.png", width, height, 3, buffer.data(), width * 3);

  return 0;
}
